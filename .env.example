SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase Storage 버킷 이름 (결과 저장용, 기본값: separated-audio)
SUPABASE_BUCKET=separated-audio

# Next.js가 올려주는 원본 파일을 받는 버킷 (기본값: stem-uploads)
SUPABASE_UPLOAD_BUCKET=stem-uploads

# 유튜브에서 추출한 오디오(mp3) 저장용 버킷 (기본값: youtube-audio, public으로 미리 만들어둬야 함)
SUPABASE_YOUTUBE_BUCKET=youtube-audio

# 피치/속도 조절 결과(mp3) 저장용 버킷 (기본값: pitch-speed-audio, public으로 미리 만들어둬야 함)
SUPABASE_PITCH_SPEED_BUCKET=pitch-speed-audio

# 드럼 펀치감 강화 등 후처리 결과(mp3) 저장용 버킷 (기본값: enhanced-audio, public으로 미리 만들어둬야 함)
SUPABASE_ENHANCE_BUCKET=enhanced-audio

# 서버 포트
PORT=5174

# Cloudflare Tunnel로 외부에 노출되므로, 요청 인증용 API 키를 설정 권장
# 설정 시 모든 요청에 헤더 X-API-Key: <값> 이 필요함 (비워두면 인증 없이 개방)
API_KEY=

# cloudflared 실행파일 경로 (기본값: ./cloudflared/cloudflared.exe)
CLOUDFLARED_PATH=

# m4a 등 soundfile이 못 읽는 포맷 디코딩용 FFmpeg 폴더
# winget install --id Gyan.FFmpeg 로 설치 후 <설치경로>\bin 을 지정
FFMPEG_DIR=

# GPU 모드(demucs-env-gpu로 실행 시)에서 Demucs -j(병렬 작업 수) 값 (기본값: 1)
# 실측 결과 1->4로 올려도 속도 차이 없었음(RTX 3070 기준, GPU 사용률이 1에서 이미 포화라 병목이 GPU 자체)
# — 굳이 안 올려도 됨, 다른 카드에서 시도해볼 여지만 남겨둠
DEMUCS_GPU_JOBS=1
